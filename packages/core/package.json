{
  "name": "@bangerpage/core",
  "version": "0.1.2",
  "description": "Runtime for Banger: presentations written as one HTML file, with frames on a canvas and a camera that stops at each point.",
  "keywords": [
    "presentation",
    "slides",
    "web-components",
    "html",
    "lit"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangerpage/banger.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bangerpage/banger/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/bangerpage/banger/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSES.txt",
    "custom-elements.json"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-legal.mjs",
    "gen:cem": "cem analyze",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^24.0.0",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "playwright-core": "^1.65.1",
    "vitest": "^5.1.0"
  },
  "customElements": "custom-elements.json",
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  }
}
