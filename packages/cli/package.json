{
  "name": "@bangerpage/cli",
  "version": "0.2.3",
  "description": "The banger command: preview, snap and export Banger presentations to PNG and PDF.",
  "keywords": [
    "presentation",
    "pdf",
    "cli",
    "playwright"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangerpage/banger.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/bangerpage/banger/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/bangerpage/banger/issues"
  },
  "bin": {
    "banger": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/copy-legal.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@bangerpage/core": "workspace:*",
    "@cantoo/pdf-lib": "^2.11.1",
    "parse5": "^8.1.1",
    "playwright-core": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "vitest": "^5.1.0"
  }
}
