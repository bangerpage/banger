{
  "name": "banger-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "gen": "node packages/core/scripts/gen-theme.mjs && pnpm -C packages/core run gen:cem && node scripts/gen-skill.mjs",
    "gen:check": "pnpm gen && git diff --exit-code"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
